{
  "name": "native-slides",
  "version": "0.1.0",
  "description": "Slides mode for Obsidian deck notes: an immersive, editable card view with a bottom bar for properties and PPT-style deck navigation — one `deck` property drives prev/next and auto-computed page numbers.",
  "main": "main.js",
  "scripts": {
    "build": "esbuild main.ts --bundle --format=cjs --external:obsidian --outfile=main.js --sourcemap=inline --define:DEV_MODE=true",
    "build:release": "esbuild main.ts --bundle --format=cjs --external:obsidian --outfile=main.js --sourcemap=inline --minify --define:DEV_MODE=false",
    "dev": "esbuild main.ts --bundle --format=cjs --external:obsidian --outfile=main.js --sourcemap=inline --watch=forever --define:DEV_MODE=true",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.24.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "obsidian": "^1.7.2",
    "prettier": "^3.9.6",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.9"
  }
}
